{
  "name": "pillwars",
  "version": "0.1.0",
  "private": true,
  "description": "PillWars - servidor multijugador (Fase 1: local)",
  "scripts": {
    "server": "node server/index.js",
    "web": "npx -y http-server -p 8123 -c-1 .",
    "admin": "node -e \"console.log('Panel: http://localhost:' + (process.env.PORT || 8080) + (process.env.ADMIN_PATH || '/admin'))\"",
    "token:devnet": "node scripts/create-devnet-token.js",
    "pill:send": "node scripts/send-pill.js",
    "sol:send": "node scripts/send-sol.js",
    "test:deposit": "node scripts/test-deposit.js",
    "design:dump": "node scripts/dump-design-layout.js"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
