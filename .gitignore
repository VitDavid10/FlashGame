server/connections.log
server/stats.json
server/players.json
server/roomrules.json
server/geo.json
server/adminlog.log
server/quests.json
server/warbalances.json
server/skinpoints.json
server/skinshop.json
server/daily.json
server/globalsettings.json
server/faucet.json
server/hostassign.json
server/layerassign.json

# Notas internas de desarrollo
tasks/
.claude/

# Binarios descargados
cloudflared.exe

# Claves SECRETAS de Solana (NUNCA subir) — la del token de devnet
scripts/.devnet-authority.json

# Dumps de arte / IA sueltos en la raíz (staging local).
# El juego solo carga desde img/, game/img/, snd/, video/.
/*.png
/*.jpg
/*.jpeg
/*.mp4
/*.webm
/*.gif

# Scripts temporales de limpieza local
_cleanup_*.py
_cleanup_*.txt

# Chatbot backend: claves y datos de usuarios (PII), nunca en git
chatbot-backend/.env
chatbot-backend/emails.json

# Originales sin pixelizar de los assets del menu (scripts/pixelize-assets.py
# los guarda para poder re-aplicar con otro --unit sin degradar el PNG)
*.png.orig

# Cache de Python de los scripts de assets
__pycache__/
*.pyc
