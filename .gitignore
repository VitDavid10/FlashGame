# Dependencias
node_modules/

# Datos de ejecución del servidor (privados: contienen IPs y stats locales)
server/connections.log
server/stats.json
server/players.json
server/roomrules.json
server/geo.json
server/adminlog.log
server/quests.json
server/warbalances.json
server/skinpoints.json
server/skinshop.json
server/daily.json
server/globalsettings.json
server/faucet.json
server/hostassign.json
server/layerassign.json
server/telegram-state.json

# Notas internas de desarrollo
tasks/
.claude/

# Binarios descargados
cloudflared.exe

# Claves SECRETAS de Solana (NUNCA subir) — la del token de devnet
scripts/.devnet-authority.json

# Dumps de arte / IA sueltos en la raíz (staging local).
# El juego solo carga desde img/, game/img/, snd/, video/.
/*.png
/*.jpg
/*.jpeg
/*.mp4
/*.webm
/*.gif

# Scripts temporales de limpieza local
_cleanup_*.py
_cleanup_*.txt

# Chatbot backend: claves y datos de usuarios (PII), nunca en git
chatbot-backend/.env
chatbot-backend/emails.json

# Originales sin pixelizar de los assets del menu (scripts/pixelize-assets.py
# los guarda para poder re-aplicar con otro --unit sin degradar el PNG)
*.png.orig

# Cache de Python de los scripts de assets
__pycache__/
*.pyc

# Clave del PROGRAMA de tesoreria: es la que fija su direccion on-chain.
# Si se filtra, cualquiera puede desplegar en esa direccion antes que tu.
# Si se PIERDE, no se puede volver a desplegar ahi nunca mas: guardala fuera de git.
programs/*-keypair.json

# Artefactos de compilacion de Anchor/Rust
target/
.anchor/

# Evidencia del visual-check de los diagramas (PNG y receipt): se regenera con
# `archify visual-check` y no aporta nada en el historial.
docs/*.visual-check.*

# Recibos de partida y sus lotes: son datos de ejecucion, como el resto de los
# .json del servidor. Los publicos se sirven por /api/matches.
server/matches/
server/matches-batch/
server/matches-state.json
server/leaderboards/
server/leaderboard-chain.json
server/leaderboard-today.json
server/rewards/
server/rewards.json
server/reserves/
server/reserves-state.json
server/rake.json
.tmp-demo/

# Claves. NUNCA en git.
scripts/.rewards-wallet.json

# Registro de movimientos: son datos del servidor, no codigo.
server/transactions.log
server/adminlog.log
scripts/.stakers-devnet.json
.tmp-ataque/

# Imagenes de las tarjetas compartidas del airdrop (las sube cada jugador)
server/airdrop-cards/

# Participantes e invitaciones del airdrop (datos personales, no van al repo)
server/airdrop-data.json
server/airdrop-data.json.tmp
# Amigos y perfiles sociales (datos personales)
server/social.json
server/social.json.tmp
# Cobros de misiones de la app por cuenta (datos personales)
server/appquests.json

# App de la dApp Store: la clave de firma vive FUERA del repo
# (C:\Users\34679\pillwars-app-signing). Esto es por si alguna vez se copia aqui:
# si se filtra, otro puede firmar "actualizaciones" de la app.
*.keystore
*.jks
android/**/*.apk
