# Servicio systemd: mantiene el servidor PillWars corriendo 24/7 y lo reinicia si falla.
# Instalar en /etc/systemd/system/pillwars.service y luego:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pillwars
# Ver logs:  journalctl -u pillwars -f

[Unit]
Description=PillWars game server
After=network.target

[Service]
Type=simple
User=pillwars
WorkingDirectory=/home/pillwars/FlashGame
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

# El servidor solo escucha en localhost; Caddy le pone el HTTPS por delante.
Environment=PORT=8080
# CAMBIA esta clave por una larga y secreta (NO dejes 1234 en producción)
Environment=ADMIN_KEY=CAMBIA_ESTA_CLAVE_LARGA
# CAMBIA estos dos paths por algo no adivinable (el repo es publico en GitHub,
# asi que NO pongas aqui el valor real y lo subas — esto es solo la plantilla;
# edita el .service real en el VPS con el valor de verdad, igual que ADMIN_KEY).
# Sin definir caen a /admin y /carteles-preview.html (los de siempre).
Environment=ADMIN_PATH=/CAMBIA-ESTE-PATH
Environment=CARTELES_PATH=/CAMBIA-ESTE-OTRO-PATH.html
# Secreto del stress test: deja entrar GRATIS a las salas de pago (solo devnet).
# SIN DEFINIR = modo tester apagado, que es lo correcto en produccion. Definelo
# solo mientras lances un stress test, y pasa el MISMO valor al bot por env.
#Environment=STRESS_KEY=CAMBIA-ESTE-SECRETO
# TRUST_PROXY: 1 (defecto) = detras de Caddy, la IP real es el ultimo salto de
# x-forwarded-for. Ponlo a 0 solo si expones Node directo, sin proxy delante.
Environment=TRUST_PROXY=1
Environment=MIN_PLAYERS=5
Environment=TARGET_POP=10
# Fase 4b — split multiproceso: el Director (8080) forkea PW_HOST_COUNT hosts
# (8081, 8082...) y reparte los combos entre ellos. Los hosts heredan este env.
# Para volver al modo mono: comenta estas 2 líneas y `systemctl restart pillwars`.
Environment=PW_ROLE=director
Environment=PW_HOST_COUNT=2

# ===================== TESORERIA Y PREMIOS =====================
# Nada de esto es obligatorio: sin TREASURY_PROGRAM el juego funciona igual y los
# depositos van a la wallet de la autoridad, como siempre. Con el, van al PDA de
# custodia, que no tiene llave privada. Ver DESPLIEGUE-TESORERIA.md.

# El programa desplegado. Definelo SOLO despues de `anchor deploy` y `init`.
#Environment=TREASURY_PROGRAM=PiLLBwuaj4eTy9cdFoiChNtbCstHZFSLeKQk13zJwMW
# El mint y el RPC salen de scripts/devnet-token.json si no se definen aqui.
#Environment=PILL_MINT=Exth8VyQVuNaJdZsUjoPK3QdegdxJBYXAnzT3mP5xY1r
#Environment=SOL_RPC=https://api.devnet.solana.com

# Comision del bote de arcade, en %. Va al pozo del staking, no a la tesoreria.
# Es el unico porcentaje que sale del bolsillo de los jugadores. Tope duro: 50.
Environment=ARCADE_RAKE_PCT=5

# --- Los dos filtros de quien puntua en el leaderboard diario ---
# Kills minimas del dia para entrar en la lista.
Environment=LB_MIN_KILLS=3
# Oponentes DISTINTOS con los que hay que haberse cruzado. Es lo que hace visible
# un cluster de wallets que solo juegan entre ellas: diez wallets mias jugando
# solas no llegan a cinco oponentes distintos de verdad.
Environment=LB_MIN_OPPONENTS=5

# --- Los dos frenos del bote que NO estan en el contrato ---
# Premio por cada PILL que la CASA se quedo ese dia (exit fees, comision de arcade,
# entradas perdidas, botes sin reclamar, tienda). No por cada PILL cobrado en
# entradas: en classic la entrada se convierte en tu carry y quien gana la sala cobra
# sin fee, asi que veinte wallets propias recuperan las veinte entradas enteras y el
# ataque cuesta CERO. El rake si es infalsificable: jugando contra ti mismo da cero.
#
# NO esta acotado a 1: con factor 1 el leaderboard se estrangula (unos 50 \$/dia con
# 500 jugadores frente a los 170 \$ del grifo). Es el multiplicador que se calibra con
# datos. Lo que no cambia: cero por cualquier factor sigue siendo cero.
Environment=REWARD_FACTOR=20

# MODO SECO: calcula las rondas y NO publica nada en la cadena. Es la herramienta de
# calibracion — en 48 h hay datos reales del rake y del bote sin gastar un token.
# Quitalo (o ponlo a 0) cuando los numeros convenzan.
Environment=REWARD_DRY_RUN=1

# Que fraccion de la gente que jugo ese dia hay que haber conocido para contar como
# jugador y no como cluster. Un cluster TIENE TECHO: con 20 wallets propias nunca
# conoceras a mas de 19 personas, juegues 4 partidas o 4.000. Sobre 500 activos eso
# es un 4 % fijo, mientras que un jugador con 4 partidas va por el 25 %.
#
# Se mide contra la POBLACION, no contra las partidas: dividir por partidas bajaba
# cuanto mas jugabas, o sea que castigaba al jugador activo y dejaba pasar al
# atacante que juega poco.
#
# El 10 % es conservador a proposito — entre echar a un jugador real y dejar pasar a
# un atacante, se prefiere lo segundo. Sube el liston a unas 55 wallets.
Environment=LB_MIN_KNOWN_PCT=0.10
# Partidas minimas para que el porcentaje signifique algo.
Environment=LB_MIN_MATCHES=2
# Jugadores en la lista del dia para que salga el bote entero. Por debajo sale
# proporcional: con 25 la mitad, con 5 la decima parte. Sin esto, doce jugadores
# echando tres partidas ya sueltan el maximo y estar en el top 10 sale gratis.
# Cuenta ELEGIBLES (hasta 100), no ganadores: siguen cobrando solo los diez primeros.
Environment=LB_FULL_POT_AT=50

# Presupuesto de premios cuando NO hay contrato configurado (fase de pruebas).
# Con TREASURY_PROGRAM puesto se ignora: el tope lo dice la Config on-chain.
Environment=REWARD_BUDGET_PILL=50000

# Estas tres se pueden cambiar cuando quieras: son del servidor, no del contrato.
# Cambiarlas NO afecta al bloqueo — el contrato pone el techo y el servidor solo
# puede pedir menos. Tras editarlas:
#   sudo systemctl daemon-reload && sudo systemctl restart pillwars

[Install]
WantedBy=multi-user.target
